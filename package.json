{
	"name": "moukie",
	"private": true,
	"type": "module",
	"workspaces": [
		"docs"
	],
	"scripts": {
		"prepare": "git config core.hooksPath .githooks || true",
		"dev": "bun run --filter docs dev",
		"build": "bun run --filter docs build",
		"check": "biome check && bun run --filter docs typecheck",
		"check:architecture": "bun run --filter docs check:architecture",
		"test": "bun run --filter docs test",
		"test:e2e": "bun run --filter docs test:e2e"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15"
	}
}
